<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- TLS only. User/debug CAs are not trusted so a compromised profile cannot MITM quotes. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
