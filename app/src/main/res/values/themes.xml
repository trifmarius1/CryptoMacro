<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CryptoMacro" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#0B0E14</item>
        <item name="android:colorBackground">#0B0E14</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="Theme.CryptoMacro.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1C1F26</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.CryptoMacro</item>
    </style>
</resources>
